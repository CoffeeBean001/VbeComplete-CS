Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', padding: '0 14px' }}><Text style={{ width: 200, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "Office 接入" }</Text><Text style={{ width: 380, fontSize: 17, color: '#1E293B' }}>{ "dynamic 后期绑定 + COM" }</Text><Text style={{ flex: 1, fontSize: 16, color: '#64748B' }}>{ "不绑 Excel / WPS 版本，一个 exe 通吃" }</Text></Box><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F8FAFC', padding: '0 14px' }}><Text style={{ width: 200, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "数据库" }</Text><Text style={{ width: 380, fontSize: 17, color: '#1E293B' }}>{ "P/Invoke 系统 winsqlite3.dll" }</Text><Text style={{ flex: 1, fontSize: 16, color: '#64748B' }}>{ "零 NuGet 依赖，双击就能跑" }</Text></Box><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', padding: '0 14px' }}><Text style={{ width: 200, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "发布" }</Text><Text style={{ width: 380, fontSize: 17, color: '#1E293B' }}>{ "PublishSingleFile → dist\\VbeComplete.exe" }</Text><Text style={{ flex: 1, fontSize: 16, color: '#64748B' }}>{ "资源必须内嵌，旁边没有散文件" }</Text></Box></Box></Box><Box style={{ height: 40, background: '#EFF6FF', borderRadius: 8, padding: '0 16px', flexDirection: 'row', alignItems: 'center' }}><Text style={{ fontSize: 16, color: '#2563EB', fontWeight: 'bold' }}>{ "本页结论：C# / .NET 10 WinExe + WinForms，零 NuGet 依赖；SQLite 直接 P/In…" }</Text></Box><Box style={{ position: 'absolute', bottom: 30, left: 60, right: 60, height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 14, color: '#64748B' }}>{ "VbeComplete-CS · 逐文件精读 · 面向零基础读者" }</Text><Text style={{ fontSize: 14, color: '#64748B' }}>{ "P06 / 87" }</Text></Box></Slide>