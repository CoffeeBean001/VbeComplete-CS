<Slide style={{ width: '1280px', height: '720px', padding: '60px', background: '#FFFFFF', display: 'flex', flexDirection: 'column', fontFamily: 'Microsoft YaHei, Arial' }}><Box style={{ height: 76, flexDirection: 'column', gap: 4, justifyContent: 'center' }}><Text style={{ fontSize: 16, color: '#2563EB', fontWeight: 'bold', letterSpacing: 1 }}>{ "第 5 站 · 收尾   /   2 / 3" }</Text><Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.2 }}>{ "命令速查" }</Text></Box><Box style={{ height: 1, background: '#E5E7EB', marginTop: 6, marginBottom: 12 }} /><Box style={{ height: 450, flexDirection: 'column', gap: 16 }}><Box style={{ flex: 1, border: '1px solid #E5E7EB', borderRadius: 8, padding: 14, flexDirection: 'column' }}><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 18, background: '#FFFFFF', padding: '0 14px' }}><Text style={{ width: 130, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "编译" }</Text><Text style={{ flex: 1, fontSize: 17, color: '#1E293B', fontFamily: 'Consolas, Arial' }}>{ "dotnet build src/VbeComplete.csproj -c Release" }</Text></Box><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 18, background: '#F8FAFC', padding: '0 14px' }}><Text style={{ width: 130, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "纯逻辑" }</Text><Text style={{ flex: 1, fontSize: 17, color: '#1E293B', fontFamily: 'Consolas, Arial' }}>{ "dist\\VbeComplete.exe --selftest" }</Text></Box><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 18, background: '#FFFFFF', padding: '0 14px' }}><Text style={{ width: 130, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "合成探针" }</Text><Text style={{ flex: 1, fontSize: 17, color: '#1E293B', fontFamily: 'Consolas, Arial' }}>{ "dist\\VbeComplete.exe --enginetest" }</Text></Box><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 18, background: '#F8FAFC', padding: '0 14px' }}><Text style={{ width: 130, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "真机探针" }</Text><Text style={{ flex: 1, fontSize: 17, color: '#1E293B', fontFamily: 'Consolas, Arial' }}>{ "dist\\VbeComplete.exe --declprobe / --fmtprobe / --hdrprobe" }</Text></Box><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 18, background: '#FFFFFF', padding: '0 14px' }}><Text style={{ width: 130, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "发布" }</Text><Text style={{ flex: 1, fontSize: 17, color: '#1E293B', fontFamily: 'Consolas, Arial' }}>{ "dotnet publish ... -r win-x64 -p:PublishSingleFile=true -o dist" }</Text></Box><Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 18, background: '#F8FAFC', padding: '0 14px' }}><Text style={{ width: 130, fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>{ "一键全跑" }</Text><Text style={{ flex: 1, fontSize: 17, color: '#1E293B', fontFamily: 'Consolas, Arial' }}>{ "check-cs.bat（12 步，改 UI 加 --uitest）" }</Text></Box></Box><Box style={{ height: 64, background: '#1E3A8A', borderRadius: 8, padding: 16, flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>{ "A/B 开关（Git Bash 写法）" }</Text><Text style={{ fontSize: 16, color: '#DBEAFE' }}>{ "VBECOMPLETE_NO_PROC_HEADER_FIX=1 dist/VbeComplete.exe --hdrprobe  →  关掉修复，必须变红" }</Text></Box></Box><Box style={{ height: 40, background: '#EFF6FF', borderRadius: 8, padding: '0 16px', flexDirection: 'row', alignItems: 'center' }}><Text style={{ fontSize: 16, color: '#2563EB', fontWeight: 'bold' }}>{ "带走：dotnet build src/VbeComplete.csproj -c Release；dist\\VbeCom…" }</Text></Box><Box style={{ position: 'absolute', bottom: 30, left: 60, right: 60, height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 14, color: '#64748B' }}>{ "VbeComplete-CS · 逐文件精读 · 面向零基础读者" }</Text><Text style={{ fontSize: 14, color: '#64748B' }}>{ "P85 / 87" }</Text></Box></Slide>